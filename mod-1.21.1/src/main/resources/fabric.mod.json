{
  "schemaVersion": 1,
  "id": "mclink",
  "version": "${version}",
  "name": "Tailcat for Minecraft",
  "description": "Peer-to-peer LAN multiplayer over Tailscale Tailcat",
  "authors": [
    "Tailscale",
    "DeepMind"
  ],
  "contact": {
    "homepage": "https://github.com/tailscale/tailcat-for-minecraft",
    "sources": "https://github.com/tailscale/tailcat-for-minecraft"
  },
  "license": "BSD-3-Clause",
  "icon": "assets/mclink/textures/gui/sprites/tailcat.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.tailscale.mclink.McLinkClient"
    ]
  },
  "mixins": [
    "mclink.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*"
  }
}
